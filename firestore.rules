rules_version = '2';

// Deploy: pnpm dlx firebase-tools deploy --only firestore:rules --project <project-id>
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: profile and data of a Firebase Auth user, only for that user.
    // Documents of the Vue 2 version are keyed by login, so nobody can read them any more;
    // scripts/migrate-users-to-auth.ts copies them to users/{uid}.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid
          && collection in ['keywords', 'topics', 'notes', 'highlights'];
      }
    }
  }
}
