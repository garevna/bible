rules_version = '2';

// Deploy: firebase deploy --only firestore:rules --project <project-id>
service cloud.firestore {
  match /databases/{database}/documents {

    // the signed in Firebase Auth user owns this login
    function isOwner(login) {
      return request.auth != null
        && get(/databases/$(database)/documents/logins/$(login)).data.uid == request.auth.uid;
    }

    // logins/{login} = { uid }: sign up checks that a login is free, sign in that it exists
    match /logins/{login} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // profile; written right after logins/{login}, so isOwner already holds
    match /users/{login} {
      allow read, create, update: if isOwner(login);
      allow delete: if false;

      // keywords, topics, notes, highlights; the old "creds" collection is closed
      match /{collection}/{docId} {
        allow read, write: if collection in ['keywords', 'topics', 'notes', 'highlights']
          && isOwner(login);
      }
    }

    // regions and cities for sign up
    match /catalogs/{catalog} {
      allow read: if true;
      allow write: if false;
    }
  }
}
